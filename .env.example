# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=10000

# Authentication
VITE_JWT_SECRET=your-super-secret-jwt-key-change-in-production
VITE_TOKEN_EXPIRY=86400000

# Payment Gateway (Stripe Test Keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# App Configuration
VITE_APP_NAME=Mango OMS
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# CDN & Assets
VITE_CDN_URL=https://cdn.yourapp.com
VITE_ASSETS_URL=/assets

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT_SUPPORT=false

# Pagination
VITE_ITEMS_PER_PAGE=12

# Security
VITE_ENABLE_CSP=true
VITE_ALLOWED_DOMAINS=localhost,yourapp.com